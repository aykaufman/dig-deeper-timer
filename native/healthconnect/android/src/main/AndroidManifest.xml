<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect.controller" />
    </queries>

    <application>
        <service
            android:name="com.aykaufman.healthconnect.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout timer that keeps counting and announcing moves while the screen is off" />
        </service>
        <receiver
            android:name="com.aykaufman.healthconnect.ActionReceiver"
            android:exported="false" />
        <!-- Health Connect shows this when you tap "privacy policy" on its permission screen (Android 13 and earlier) -->
        <activity
            android:name="com.aykaufman.healthconnect.PrivacyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Same screen on Android 14 and later -->
        <activity-alias
            android:name="com.aykaufman.healthconnect.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.aykaufman.healthconnect.PrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
